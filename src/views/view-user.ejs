<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View a user</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</head>

<body>
  <div style="width: 600; margin: auto;">
    <h3 style="padding: 10px 0;">View detail a user id = <%= id %>
    </h3>
    <form action="/handle-update-user" method="post">
      <input style="display: none;" name="id" value="<%= user.id %>">
      <div class="mb-3">
        <label class="form-label">Name:</label>
        <input value="<%= user.name %>" name="fullName" type="text" class="form-control" placeholder="your name">
      </div>
      <div class="mb-3">
        <label class="form-label">Email:</label>
        <input value="<%= user.email %>" name="email" type="email" class="form-control" placeholder="name@example.com">
      </div>
      <div class="mb-3">
        <label class="form-label">Adress:</label>
        <textarea name="address" class="form-control" rows="3"><%= user.address %></textarea>
      </div>
      <div class="mb-3">
        <button type="submit" class="btn btn-warning">Update</button>
      </div>
    </form>
  </div>
</body>

</html>